# ---------------------------------------------------------------------------
# Tech Microlearning — all runtime configuration lives here.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
APP_NAME="Tech Microlearning"
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db
# (install the matching driver). Relative SQLite paths resolve from the project root.
DATABASE_URL=sqlite:///./data/microlearning.db

# --- Sources ----------------------------------------------------------------
# Comma-separated list of: youtube, reddit, hackernews, devto, medium, substack
ENABLED_SOURCES=youtube,reddit,hackernews,devto,medium,substack

# YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
# Each topic crawl costs ~101 quota units (default quota is 10,000/day).
YOUTUBE_API_KEY=
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_REGION_CODE=

# Reddit "script" app credentials (https://www.reddit.com/prefs/apps).
# Reddit blocks anonymous API access, so the source is skipped when these are empty.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tech-microlearning/0.1 (personal microlearning app)
REDDIT_MIN_SCORE=10

# Hacker News stories need at least this many points to be kept.
HACKERNEWS_MIN_POINTS=20

# Substack (no key needed; uses the search behind substack.com, which is unofficial).
# Paid posts only show a preview, so they are skipped unless you subscribe to those newsletters.
SUBSTACK_INCLUDE_PAID=false
# Each page of search results holds roughly 7-10 posts.
SUBSTACK_MAX_PAGES=3

# --- Crawling ---------------------------------------------------------------
CRAWL_RESULTS_PER_SOURCE=15
# Items fetched from each preferred source (channel, subreddit, publication…) per topic crawl.
# 0 = don't search preferred sources directly, only rank them first in the feed.
# Note: each preferred YouTube channel costs ~101 quota units per topic crawl.
PREFERRED_SOURCE_RESULTS=5
# Re-crawl all active topics every N minutes (0 disables the scheduler).
CRAWL_INTERVAL_MINUTES=360
CRAWL_ON_STARTUP=false
HTTP_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=Mozilla/5.0 (compatible; TechMicrolearning/0.1)

# Fetch linked articles that have no reading time and estimate it from word count.
ESTIMATE_READING_TIME=true
READING_WORDS_PER_MINUTE=230
MAX_CONCURRENT_PAGE_FETCHES=5

# --- Feed -------------------------------------------------------------------
# Relative feed weight for priorities P1,P2,P3,P4,P5 (P1 = most important).
PRIORITY_WEIGHTS=16,8,4,2,1
FEED_DEFAULT_SIZE=12

# Defaults for the user preferences (editable in the Settings screen afterwards).
DEFAULT_MAX_VIDEO_MINUTES=10
DEFAULT_MAX_READING_MINUTES=8
